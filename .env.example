# Root .env.example — copy to .env and adjust for local development.
# This is the single shared env file for backend and frontend.

# === Backend ===
# Postgres connection string. For local dev with docker-compose use:
#   postgresql+psycopg://aqualens:aqualens@db:5432/aqualens
# For Supabase / Neon use the connection string they provide (psycopg driver).
DATABASE_URL=postgresql+psycopg://aqualens:aqualens@localhost:5432/aqualens

# Comma-separated origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Google AI Studio API key for Gemini 2.5 Flash (free tier, no card required).
# Obtain at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Optional second Gemini key. When the primary key returns a quota /
# rate-limit error, the reasoning service automatically retries with this
# one before giving up. Leave blank if you only have one key.
GOOGLE_API_KEY_FALLBACK=

# Optional third Gemini key. Used only when both primary and first
# fallback key are exhausted.
GOOGLE_API_KEY_FALLBACK_2=

# Optional override for the Gemini model id.
GEMINI_MODEL=gemini-2.5-flash

# Agent-runtime quota handling.
# Number of passes across available keys when quota errors occur.
GEMINI_QUOTA_RETRY_PASSES=2
# Cooldown (seconds) before retrying a quota-exhausted key.
GEMINI_QUOTA_COOLDOWN_SECONDS=8

# Microsoft Planetary Computer base URL. Defaults are fine for production.
PC_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# How recent satellite imagery must be (days). 30 is a sensible default.
DEFAULT_LOOKBACK_DAYS=30

# Maximum cloud cover percentage when picking a Sentinel-2 scene.
MAX_CLOUD_COVER=30

# Where uploaded field photos are written.
UPLOAD_DIR=backend/data/uploads

# Where generated PDF reports are cached.
REPORT_DIR=backend/data/reports

# Optional local testing toggles.
AQUALENS_USE_SAMPLE_PROVIDER=0
AQUALENS_FAKE_GEMINI=0

# Multi-agent layer. Default `true` runs Coordinator → Scout → Historian
# → Analyst → Reporter for each session and persists the trace.
# Set to `false` to fall back to the single-call narrative path —
# useful for CI and for diffing the two output styles side-by-side.
AQUALENS_AGENTIC_MODE=true

# Optional pacing delay between agent stages (milliseconds). Keep `0`
# for fastest execution; set (e.g.) `500` for a more visible live flow.
AQUALENS_AGENT_STEP_DELAY_MS=0

# Embeddings model used by the Historian's semantic-memory recall.
GEMINI_EMBEDDING_MODEL=text-embedding-004

# === Frontend ===
# Public base URL of the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public site URL used for canonical links and OG metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
